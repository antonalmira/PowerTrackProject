<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1200</width><height>800</height></rect>
  </property>
  <property name="windowTitle">
   <string>Power Track</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QMainWindow { background: transparent; }
    QWidget#centralwidget { background: #16161a; border: 1px solid #3a3a40; border-radius: 12px; }
    QFrame#headerr, QFrame#footer { background: transparent; border: none; }
    QFrame#selectionframe { background: #202025; border: 1px solid #3a3a40; border-radius: 8px; }
    
    /* Buttons */
    #centralwidget QPushButton { padding: 0px 15px; background: #0085ca; color: white; border-radius: 5px; font-weight: bold; min-height: 28px; }
    #centralwidget QPushButton:hover { background: #3c649f; }
    #centralwidget QPushButton:disabled { background: #333333; color: #777777; }
    #headerr QPushButton { padding: 0px; }
    
    /* Main Tabs Navigation */
    QPushButton#btn_tab_students, QPushButton#btn_tab_matrix, QPushButton#btn_tab_analytics {
        padding: 0px 10px; background-color: transparent; color: #777777; border: none; border-bottom: 3px solid transparent; border-radius: 0px; font-size: 14px;
    }
    QPushButton#btn_tab_students:hover, QPushButton#btn_tab_matrix:hover, QPushButton#btn_tab_analytics:hover { background-color: #2a2a30; }
    QPushButton#btn_tab_students:checked, QPushButton#btn_tab_matrix:checked, QPushButton#btn_tab_analytics:checked { color: white; border-bottom: 3px solid #0085ca; font-weight: bold; }

    /* Inputs */
    #centralwidget QLineEdit, #centralwidget QComboBox { background: #1a1a1e; color: #e0e0e0; border-radius: 4px; padding: 4px 5px; border: 1px solid #3a3a40; min-height: 20px;}
    
    /* Group Boxes */
    QGroupBox { color: #f0f0f0; border: 1px solid #3a3a40; border-radius: 5px; margin-top: 10px; font-weight: bold; }
    QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 5px; }
    
    /* Global TabWidget / TabBar (Forced explicit sizing for Analytics and Matrix sub-tabs) */
    QTabWidget::pane { border: none; background: transparent; }
    QTabBar { qproperty-expanding: 1; }
    QTabWidget::tab-bar { left: 0px; right: 0px; alignment: center; }
    QTabBar::tab { 
        background: #202025; 
        color: #777777; 
        border: 1px solid #3a3a40; 
        padding: 8px 15px; 
        font-size: 14px; 
        min-width: 120px;
        min-height: 20px;
    }
    QTabBar::tab:selected { background: #0085ca; color: white; border: 1px solid #0085ca; font-weight: bold; }
    QTabBar::tab:hover:!selected { background: #2a2a30; }
    
    /* Tables */
    QTableWidget { alternate-background-color: #1a1a1e; background: #121214; color: #f0f0f0; border: 1px solid #3a3a40; border-radius: 5px; font-size: 13px; gridline-color: #3a3a40; }
    QHeaderView::section { background-color: #202025; color: white; padding: 6px; border: 1px solid #3a3a40; font-weight: bold; font-size: 13px; }
    QTableWidget::item:selected { background-color: #0085ca; color: white; }
    QTableCornerButton::section { background-color: #202025; border: 1px solid #3a3a40; }
    
    /* Matrix Headers specifically */
    QTableWidget#header_table { border-bottom: none; border-bottom-left-radius: 0px; border-bottom-right-radius: 0px; }
    QTableWidget#table_matrix { border-top-left-radius: 0px; border-top-right-radius: 0px; }
    
    /* Scroll Areas */
    QScrollArea { border: 1px solid #3a3a40; background-color: #121214; border-radius: 4px; }

    #centralwidget QLabel { color: white; border: none; }
    
    /* Color Specific Buttons */
    #btn_update_status { background: #ffaa00; color: #121214; }
    #btn_update_status:hover { background: #cc8800; }
    #btn_refresh, #btn_refresh_matrix { background: #87ceeb; color: #121214; }
    #btn_refresh:hover, #btn_refresh_matrix:hover { background: #5bb2d4; }
    #btn_clear_filters, #btn_clear_matrix { background: #f08080; color: #121214; }
    #btn_clear_filters:hover, #btn_clear_matrix:hover { background: #cd5c5c; }
   </string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="verticalLayout_main">
    <property name="spacing"><number>0</number></property>
    <property name="margin"><number>0</number></property>
    <item>
     <widget class="QFrame" name="headerr">
      <property name="minimumSize"><size><width>0</width><height>50</height></size></property>
      <layout class="QHBoxLayout" name="horizontalLayout_header">
       <item><widget class="QLabel" name="data_exporter"><property name="font"><font><family>Bahnschrift</family><pointsize>16</pointsize><bold>true</bold></font></property><property name="text"><string>Power Track</string></property></widget></item>
       <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
       <item><widget class="QPushButton" name="minimize_button"><property name="maximumSize"><size><width>30</width><height>30</height></size></property><property name="text"><string>—</string></property></widget></item>
       <item><widget class="QPushButton" name="maximize_button"><property name="maximumSize"><size><width>30</width><height>30</height></size></property><property name="text"><string>▢</string></property></widget></item>
       <item><widget class="QPushButton" name="exit_button"><property name="maximumSize"><size><width>30</width><height>30</height></size></property><property name="text"><string>✕</string></property></widget></item>
      </layout>
     </widget>
    </item>
    <item>
     <layout class="QHBoxLayout" name="horizontalLayout_body">
      <property name="margin"><number>15</number></property>
      <property name="spacing"><number>15</number></property>
      
      <!-- MAIN PANEL -->
      <item>
       <widget class="QFrame" name="selectionframe">
        <layout class="QVBoxLayout" name="verticalLayout_selection">
         <property name="margin"><number>15</number></property>
         <property name="spacing"><number>15</number></property>
         
         <!-- NAVIGATION -->
         <item>
          <layout class="QHBoxLayout" name="tab_layout">
           <property name="spacing"><number>0</number></property>
           <item>
            <widget class="QPushButton" name="btn_tab_students">
             <property name="minimumSize"><size><width>120</width><height>35</height></size></property>
             <property name="text"><string>Students</string></property>
             <property name="checkable"><bool>true</bool></property>
             <property name="checked"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_tab_matrix">
             <property name="minimumSize"><size><width>120</width><height>35</height></size></property>
             <property name="text"><string>Course Matrix</string></property>
             <property name="checkable"><bool>true</bool></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="btn_tab_analytics">
             <property name="minimumSize"><size><width>120</width><height>35</height></size></property>
             <property name="text"><string>Analytics</string></property>
             <property name="checkable"><bool>true</bool></property>
            </widget>
           </item>
           <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
          </layout>
         </item>
         
         <item>
          <widget class="QStackedWidget" name="stackedWidget">
           <property name="currentIndex"><number>0</number></property>
           
           <!-- PAGE 0: STUDENTS -->
           <widget class="QWidget" name="page_students">
            <layout class="QVBoxLayout" name="layout_page_students">
             <property name="margin"><number>0</number></property>
             <item>
              <widget class="QGroupBox" name="group_filters">
               <property name="title"><string>Filters</string></property>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>Search:</string></property></widget></item>
                <item><widget class="QLineEdit" name="search_student"></widget></item>
                <item><widget class="QLabel"><property name="text"><string>Location/Region:</string></property></widget></item>
                <item><widget class="QComboBox" name="combo_region"></widget></item>
                <item><widget class="QLabel"><property name="text"><string>Progress:</string></property></widget></item>
                <item><widget class="QComboBox" name="combo_progress"></widget></item>
                <item><widget class="QPushButton" name="btn_clear_filters"><property name="text"><string>Clear Filters</string></property></widget></item>
                <item><widget class="QPushButton" name="btn_edit_progress"><property name="text"><string>Edit Logic</string></property><property name="styleSheet"><string>background: #0085ca; color: white;</string></property></widget></item>
                 <item><widget class="QPushButton" name="btn_email_students"><property name="text"><string>Email Students</string></property><property name="styleSheet"><string>background: #0085ca; color: white;</string></property></widget></item>
                <item><widget class="QLabel" name="lbl_showing"><property name="text"><string>Showing all 0 students</string></property><property name="styleSheet"><string>color: #5bb2d4;</string></property></widget></item>
                <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
               </layout>
              </widget>
             </item>
             
             <!-- FIXED SUB TABS (No expanding container) -->
             <item>
              <widget class="QTabBar" name="tabBar_students">
              </widget>
             </item>

             <item>
              <layout class="QHBoxLayout">
               <item><widget class="QLabel" name="lbl_total"><property name="text"><string>&lt;b&gt;Total: 0&lt;/b&gt;</string></property></widget></item>
               <item><widget class="QLabel" name="lbl_internal"><property name="text"><string>Internal: 0</string></property></widget></item>
               <item><widget class="QLabel" name="lbl_external"><property name="text"><string>External: 0</string></property></widget></item>
               <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
              </layout>
             </item>
             <item>
              <widget class="QTableWidget" name="table_students">
              </widget>
             </item>
             <item>
              <layout class="QHBoxLayout">
               <item><widget class="QPushButton" name="btn_update_status"><property name="text"><string>Load Base Data</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_refresh"><property name="text"><string>Update Data</string></property></widget></item>
               <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
              </layout>
             </item>
            </layout>
           </widget>
           
           <!-- PAGE 1: COURSE MATRIX -->
           <widget class="QWidget" name="page_matrix">
            <layout class="QVBoxLayout" name="layout_page_matrix">
             <property name="margin"><number>0</number></property>
             <item>
              <widget class="QGroupBox" name="group_matrix_filters">
               <property name="title"><string>Matrix Filters</string></property>
               <layout class="QHBoxLayout">
                <item><widget class="QLabel"><property name="text"><string>Search:</string></property></widget></item>
                <item><widget class="QLineEdit" name="search_matrix"></widget></item>
                <item><widget class="QLabel"><property name="text"><string>Control Code:</string></property></widget></item>
                <item><widget class="QComboBox" name="combo_matrix_code"></widget></item>
                <item><widget class="QLabel"><property name="text"><string>Region:</string></property></widget></item>
                <item><widget class="QComboBox" name="combo_matrix_region"></widget></item>
                <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
               </layout>
              </widget>
             </item>
             
             <!-- FIXED SUB TABS (No expanding container) -->
             <item>
              <widget class="QTabBar" name="tabBar_matrix">
              </widget>
             </item>

             <!-- BUNDLED HEADER AND TABLE -->
             <item>
              <layout class="QVBoxLayout" name="layout_matrix_tables">
               <property name="spacing"><number>0</number></property>
               <item>
                <widget class="QTableWidget" name="header_table">
                 <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
                 <property name="focusPolicy"><enum>Qt::NoFocus</enum></property>
                 <property name="wordWrap"><bool>true</bool></property>
                 <!-- FIX: Explicitly hide XML Horizontal Header to be safe -->
                 <attribute name="horizontalHeaderVisible">
                  <bool>false</bool>
                 </attribute>
                </widget>
               </item>
               <item>
                <widget class="QTableWidget" name="table_matrix">
                 <!-- FIX: Explicitly hide XML Horizontal Header to be safe -->
                 <attribute name="horizontalHeaderVisible">
                  <bool>false</bool>
                 </attribute>
                </widget>
               </item>
              </layout>
             </item>
             
             <item>
              <layout class="QHBoxLayout">
               <item><widget class="QPushButton" name="btn_refresh_matrix"><property name="text"><string>Map Courses</string></property></widget></item>
               <item><widget class="QPushButton" name="btn_clear_matrix"><property name="text"><string>Export Matrix</string></property></widget></item>
               <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
              </layout>
             </item>
            </layout>
           </widget>

           <!-- PAGE 2: ANALYTICS -->
           <widget class="QWidget" name="page_analytics">
            <layout class="QVBoxLayout" name="layout_page_analytics">
             <property name="margin"><number>0</number></property>
             <item>
              <widget class="QTabWidget" name="tabWidget_analytics">
               <property name="documentMode">
                <bool>true</bool>
               </property>
               
               <!-- FAE ANALYTICS TAB -->
               <widget class="QWidget" name="tab_ana_fae">
                <attribute name="title"><string>FAE</string></attribute>
                <layout class="QVBoxLayout">
                 <property name="margin"><number>0</number></property>
                 <item>
                  <widget class="QTabWidget" name="tab_fae">
                   <property name="documentMode">
                    <bool>true</bool>
                   </property>
                   <widget class="QWidget" name="tab_fae_table">
                    <attribute name="title"><string>Table</string></attribute>
                    <layout class="QVBoxLayout"><property name="margin"><number>0</number></property>
                     <item><widget class="QTableWidget" name="table_fae"></widget></item>
                    </layout>
                   </widget>
                   <widget class="QWidget" name="tab_fae_charts">
                    <attribute name="title"><string>Charts</string></attribute>
                    <layout class="QVBoxLayout"><property name="margin"><number>0</number></property>
                     <item><widget class="QScrollArea" name="scroll_fae"><property name="widgetResizable"><bool>true</bool></property></widget></item>
                    </layout>
                   </widget>
                  </widget>
                 </item>
                 <item>
                  <layout class="QHBoxLayout">
                   <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                   <item><widget class="QPushButton" name="btn_export_fae"><property name="text"><string>Export FAE</string></property><property name="minimumHeight"><number>35</number></property></widget></item>
                  </layout>
                 </item>
                </layout>
               </widget>

               <!-- SALES ANALYTICS TAB -->
               <widget class="QWidget" name="tab_ana_sales">
                <attribute name="title"><string>Sales</string></attribute>
                <layout class="QVBoxLayout">
                 <property name="margin"><number>0</number></property>
                 <item>
                  <widget class="QTabWidget" name="tab_sales">
                   <property name="documentMode">
                    <bool>true</bool>
                   </property>
                   <widget class="QWidget" name="tab_sales_table">
                    <attribute name="title"><string>Table</string></attribute>
                    <layout class="QVBoxLayout"><property name="margin"><number>0</number></property>
                     <item><widget class="QTableWidget" name="table_sales"></widget></item>
                    </layout>
                   </widget>
                   <widget class="QWidget" name="tab_sales_charts">
                    <attribute name="title"><string>Charts</string></attribute>
                    <layout class="QVBoxLayout"><property name="margin"><number>0</number></property>
                     <item><widget class="QScrollArea" name="scroll_sales"><property name="widgetResizable"><bool>true</bool></property></widget></item>
                    </layout>
                   </widget>
                  </widget>
                 </item>
                 <item>
                  <layout class="QHBoxLayout">
                   <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                   <item><widget class="QPushButton" name="btn_export_sales"><property name="text"><string>Export Sales</string></property><property name="minimumHeight"><number>35</number></property></widget></item>
                  </layout>
                 </item>
                </layout>
               </widget>

               <!-- SUMMARY ANALYTICS TAB -->
               <widget class="QWidget" name="tab_ana_summary">
                <attribute name="title"><string>Summary</string></attribute>
                <layout class="QVBoxLayout">
                 <property name="margin"><number>0</number></property>
                 <item>
                  <widget class="QTabWidget" name="tab_summary">
                   <property name="documentMode">
                    <bool>true</bool>
                   </property>
                   <widget class="QWidget" name="tab_summary_table">
                    <attribute name="title"><string>Table</string></attribute>
                    <layout class="QVBoxLayout"><property name="margin"><number>0</number></property>
                     <item><widget class="QTableWidget" name="table_summary"></widget></item>
                    </layout>
                   </widget>
                   <widget class="QWidget" name="tab_summary_charts">
                    <attribute name="title"><string>Charts</string></attribute>
                    <layout class="QVBoxLayout"><property name="margin"><number>0</number></property>
                     <item><widget class="QScrollArea" name="scroll_summary"><property name="widgetResizable"><bool>true</bool></property></widget></item>
                    </layout>
                   </widget>
                  </widget>
                 </item>
                 <item>
                  <layout class="QHBoxLayout">
                   <item><widget class="QComboBox" name="combo_snapshot_month">
                     <property name="minimumHeight"><number>35</number></property>
                     <item><property name="text"><string>Jan</string></property></item>
                     <item><property name="text"><string>Feb</string></property></item>
                     <item><property name="text"><string>Mar</string></property></item>
                     <item><property name="text"><string>Apr</string></property></item>
                     <item><property name="text"><string>May</string></property></item>
                     <item><property name="text"><string>Jun</string></property></item>
                     <item><property name="text"><string>Jul</string></property></item>
                     <item><property name="text"><string>Aug</string></property></item>
                     <item><property name="text"><string>Sep</string></property></item>
                     <item><property name="text"><string>Oct</string></property></item>
                     <item><property name="text"><string>Nov</string></property></item>
                     <item><property name="text"><string>Dec</string></property></item>
                   </widget></item>
                   <item><widget class="QPushButton" name="btn_save_snapshot">
                     <property name="text"><string>Save Month Snapshot</string></property>
                     <property name="minimumHeight"><number>35</number></property>
                     <property name="styleSheet"><string>background: #00B050; color: white;</string></property>
                   </widget></item>
                   <item><spacer><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
                   <item><widget class="QPushButton" name="btn_export_summary"><property name="text"><string>Export History</string></property><property name="minimumHeight"><number>35</number></property></widget></item>
                  </layout>
                 </item>
                </layout>
               </widget>

              </widget>
             </item>
            </layout>
           </widget>
           
          </widget>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
