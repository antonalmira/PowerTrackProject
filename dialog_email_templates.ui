   <string notr="true">
    QDialog { background: #202025; color: white; }
    QLabel { color: white; font-weight: bold; }
    QLineEdit, QTextEdit, QComboBox { background: #121214; color: white; border: 1px solid #3a3a40; border-radius: 4px; padding: 5px; }
