    QPushButton#btn_save { background: #0085ca; color: white; font-size: 14px;}
    QPushButton#btn_save:hover { background: #3c649f; }
    
    QScrollBar:vertical { background: #121214; width: 14px; margin: 0px 0px 0px 0px; border-left: 1px solid #3a3a40; }
    QScrollBar::handle:vertical { background: #3a3a40; min-height: 20px; border-radius: 7px; margin: 2px; }
    QScrollBar::handle:vertical:hover { background: #555555; }
    QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
    
    QScrollBar:horizontal { background: #121214; height: 14px; margin: 0px 0px 0px 0px; border-top: 1px solid #3a3a40; }
    QScrollBar::handle:horizontal { background: #3a3a40; min-width: 20px; border-radius: 7px; margin: 2px; }
    QScrollBar::handle:horizontal:hover { background: #555555; }
