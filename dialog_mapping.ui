  <property name="styleSheet">
   <string notr="true">
    QDialog { background: #202025; color: white; }
    QLabel { color: white; font-weight: bold; }
    QTreeWidget, QListWidget { background: #121214; border: 1px solid #3a3a40; color: white; outline: none; border-radius: 4px; padding: 4px;}
    QTreeWidget::item:selected, QListWidget::item:selected { background: #0085ca; }
